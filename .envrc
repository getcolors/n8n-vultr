# -*- mode: sh; sh-shell: bash -*-
export DIRENV_WARN_TIMEOUT=20s
eval "$(devenv direnvrc)"
use devenv 2>/dev/null
source_env_if_exists .envrc.private

# The storage tier is the getcolors/neon package, rendered from a SHA pin. Its
# play reads exactly COLORS_PAR_NEON_R2_ACCESS_KEY_ID and
# COLORS_PAR_NEON_R2_SECRET_ACCESS_KEY via lookup('env', ...) at execution time,
# and ansible-playbook inherits this environment.
#
# Supplying a dedicated pair in .envrc.private is the better posture and takes
# precedence automatically. Absent one, the shared R2 pair is mapped across
# here -- non-secret plumbing in a tracked file, with the values still living
# only in the gitignored .envrc.private.
#
# Getting this wrong does not fail quietly: neon's own guard catches it as
#   TASK [Refuse to converge with empty credentials] ... stderr: "empty R2 key id"
: "${COLORS_PAR_NEON_R2_ACCESS_KEY_ID:=${COLORS_PAR_R2_ACCESS_KEY_ID:-}}"
: "${COLORS_PAR_NEON_R2_SECRET_ACCESS_KEY:=${COLORS_PAR_R2_SECRET_ACCESS_KEY:-}}"
export COLORS_PAR_NEON_R2_ACCESS_KEY_ID COLORS_PAR_NEON_R2_SECRET_ACCESS_KEY
